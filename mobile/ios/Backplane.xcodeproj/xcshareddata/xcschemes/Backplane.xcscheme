            <ActionContent
               title = "Bring back the Mac snapshots"
               scriptText = "# The Mac tests run inside the sandboxed app, which cannot write the&#10;# source tree: the snapshots they recorded wait in the app&apos;s container&#10;# (BackplaneTests/Snapshot.swift). Bring them into __Snapshots__.&#10;src=&quot;$HOME/Library/Containers/${BASE_BUNDLE_ID}/Data/tmp/BackplaneSnapshots&quot;&#10;[ -d &quot;$src&quot; ] || exit 0&#10;rsync -rc &quot;$src/&quot; &quot;${SRCROOT}/BackplaneTests/__Snapshots__/&quot;&#10;rm -rf &quot;$src&quot;&#10;">
               <EnvironmentBuildable>
                  <BuildableReference
                     BuildableIdentifier = "primary"
                     BlueprintIdentifier = "A10000000000000000000006"
                     BuildableName = "Backplane.app"
                     BlueprintName = "Backplane"
                     ReferencedContainer = "container:Backplane.xcodeproj">
                  </BuildableReference>
               </EnvironmentBuildable>
            </ActionContent>
         </ExecutionAction>
      </PostActions>
